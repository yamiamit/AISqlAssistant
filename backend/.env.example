# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file.

# --- App metadata database (users, connections, chats, saved queries) ---
# Local dev example:  postgresql://postgres:postgres@localhost:5432/app_db
# Neon example:        postgresql://user:password@ep-xxxx.neon.tech/app_db?sslmode=require
APP_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_db

# --- Auth ---
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Encryption key for target-DB credentials at rest ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# --- AI provider ---
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest
AI_REQUEST_TIMEOUT_SECONDS=30

# --- SQL execution safety ---
SQL_STATEMENT_TIMEOUT_MS=10000
SQL_DEFAULT_ROW_LIMIT=500

# --- CORS: comma-separated list of allowed frontend origins ---
CORS_ORIGINS=http://localhost:5173

# --- File uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=15
